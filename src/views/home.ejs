<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" type="image/png" href="/images/favicon.png" />
    <link rel="apple-touch-icon" href="/images/icon.png" />
    <title>Daily Story — A short story a day, in the language you're learning</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="/css/index.css">
    <link rel="stylesheet" href="/css/home.css">

    <script>
        !function(t,e){var o,n,p,r;e.__SV||(window.posthog=e,e._i=[],e.init=function(i,s,a){function g(t,e){var o=e.split(".");2==o.length&&(t=t[o[0]],e=o[1]),t[e]=function(){t.push([e].concat(Array.prototype.slice.call(arguments,0)))}}(p=t.createElement("script")).type="text/javascript",p.async=!0,p.src=s.api_host.replace(".i.posthog.com","-assets.i.posthog.com")+"/static/array.js",(r=t.getElementsByTagName("script")[0]).parentNode.insertBefore(p,r);var u=e;for(void 0!==a?u=e[a]=[]:a="posthog",u.people=u.people||[],u.toString=function(t){var e="posthog";return"posthog"!==a&&(e+="."+a),t||(e+=" (stub)"),e},u.people.toString=function(){return u.toString(1)+".people (stub)"},o="init capture register register_once register_for_session unregister opt_out_capturing has_opted_out_capturing opt_in_capturing reset isFeatureEnabled getFeatureFlag getFeatureFlagPayload reloadFeatureFlags group identify setPersonProperties setPersonPropertiesForFlags resetPersonPropertiesForFlags setGroupPropertiesForFlags resetGroupPropertiesForFlags resetGroups onFeatureFlags addFeatureFlagsHandler onSessionId getSurveys getActiveMatchingSurveys renderSurvey canRenderSurvey getNextSurveyStep".split(" "),n=0;n<o.length;n++)g(u,o[n]);e._i.push([i,s,a])},e.__SV=1)}(document,window.posthog||[]);
        posthog.init('phc_iUdVH98M9tw8Qt3iOYecZpubxPZKhGtLfXc5poXS1wR', {
            cookieless_mode: 'always',
            api_host: 'https://us.i.posthog.com',
            defaults: '2026-01-30'
        })
    </script>
</head>
<body>
    <%
        // Native names shown next to each language in the picker, so the option
        // reads e.g. "Español — Spanish". Any language missing here simply falls
        // back to its English name.
        const nativeNames = {
            English: 'English',
            Spanish: 'Español',
            French: 'Français',
            German: 'Deutsch',
            Italian: 'Italiano',
            Portuguese: 'Português',
            Chinese: '中文',
            Japanese: '日本語'
        };

        // Plain-language descriptions shown at the point of choice so users
        // don't need to already know what CEFR levels mean. Ordered simplest to
        // most advanced, matching earlyLevels + intermediateLevels (A1..B2).
        const levelInfo = {
            A1: { name: 'Beginner',     desc: 'Greetings, ordering food, asking directions.' },
            A2: { name: 'Conversational', desc: 'Making plans, hobbies, and simple opinions.' },
            B1: { name: 'Intermediate', desc: 'Experiences, opinions, everyday discussions.' },
            B2: { name: 'Advanced',     desc: 'Debates, analysis, and nuanced topics.' }
        };
        const orderedLevels = [...earlyLevels, ...intermediateLevels];
    %>

    <div class="grain" aria-hidden="true"></div>

    <!-- ============ HEADER ============ -->
    <header class="site-header" id="top">
        <a class="brand" href="/">
            <span class="brand-dot"></span>
            <span class="brand-name">Daily Story</span>
        </a>
        <nav class="site-nav">
            <a href="#story">How it works</a>
            <a href="#levels">Levels</a>
            <% if (isLoggedIn) { %>
                <form action="/logout" method="post" class="nav-form">
                    <button type="submit">Sign out</button>
                </form>
            <% } else { %>
                <a href="/login" class="nav-strong">Log in</a>
            <% } %>
        </nav>
    </header>

    <!-- ============ HERO ============ -->
    <section class="hero">
        <div class="hero-copy">
            <p class="eyebrow">A new story every day</p>
            <h1>A short story a day, in the language you're <em>learning</em>.</h1>
            <p class="hero-lead">
                Every morning, read a new conversation matched to
                your level. Read it in five minutes, then check yourself with
                three quick questions.
            </p>

            <!-- Picker card — the real entry point into today's story -->
            <form class="picker" id="storyForm" novalidate>
                <div class="picker-grid">
                    <label class="field">
                        <span class="field-label">I want to read in</span>
                        <span class="select-wrap">
                            <select id="language" name="language">
                                <option value="" disabled <%= !preferredLanguage ? 'selected' : '' %>>Choose a language…</option>
                                <% languages.forEach(lang => {
                                       const native = nativeNames[lang] || lang; %>
                                    <option value="<%= lang.toLowerCase() %>"<%= preferredLanguage === lang.toLowerCase() ? ' selected' : '' %>><%= native %> — <%= lang %></option>
                                <% }) %>
                            </select>
                            <span class="caret" aria-hidden="true">▼</span>
                        </span>
                    </label>
                    <label class="field">
                        <span class="field-label">At a level</span>
                        <span class="select-wrap">
                            <select id="level" name="level">
                                <option value="" disabled <%= !preferredLevel ? 'selected' : '' %>>Pick a level…</option>
                                <% orderedLevels.forEach(level => {
                                       const info = levelInfo[level] || { name: '' }; %>
                                    <option value="<%= level.toLowerCase() %>"<%= preferredLevel === level.toLowerCase() ? ' selected' : '' %>><%= info.name %> (<%= level %>)</option>
                                <% }) %>
                            </select>
                            <span class="caret" aria-hidden="true">▼</span>
                        </span>
                    </label>
                </div>
                <div class="picker-actions">
                    <a href="#levels" class="picker-help">Not sure which level?</a>
                    <button type="submit" class="btn-start" aria-disabled="true">Read today's story →</button>
                </div>
                <p class="picker-error" id="pickerError" hidden role="alert">
                    Choose a language and a level to start reading.
                </p>
            </form>

            <ul class="chips" aria-label="What to expect">
                <li>Free</li>
                <li>No sign-up</li>
                <li>New story daily</li>
                <li>8 languages</li>
                <li>~5 min read</li>
            </ul>
        </div>

        <!-- Static preview of the reading experience -->
        <div class="hero-preview" aria-hidden="true">
            <div class="card-shadow"></div>
            <div class="card">
                <div class="card-head">
                    <span class="card-title">En la cafetería</span>
                    <span class="card-tag">Español · A1</span>
                </div>
                <div class="msg left">
                    <div class="msg-inner">
                        <div class="msg-who">Camarero</div>
                        <div class="bubble">¡Hola! ¿Qué desea tomar?</div>
                    </div>
                </div>
                <div class="msg right">
                    <div class="msg-inner">
                        <div class="msg-who">Cliente</div>
                        <div class="bubble">Un café con leche, por favor.</div>
                    </div>
                </div>
                <div class="msg left">
                    <div class="msg-inner">
                        <div class="msg-who">Camarero</div>
                        <div class="bubble">¿Grande o pequeño?</div>
                    </div>
                </div>
                <div class="card-foot">
                    <span class="q-dot">?</span>
                    then three quick questions
                </div>
            </div>
        </div>
    </section>

    <!-- ============ STORY SHOWCASE ============ -->
    <section class="showcase" id="story">
        <div class="showcase-inner">
            <div class="section-head">
                <p class="eyebrow">What a story looks like</p>
                <h2>Little conversations you can actually follow.</h2>
                <p>
                    Not textbook drills — real back-and-forth between people,
                    ending in three quick questions. Try one:
                </p>
            </div>

            <div class="story-tabs" id="storyTabs" role="tablist"></div>
            <div class="story-card" id="storyCard"></div>
        </div>
    </section>

    <!-- ============ LEVELS ============ -->
    <section class="levels" id="levels">
        <div class="section-head">
            <p class="eyebrow">Find your level</p>
            <h2>From your first words to real fluency.</h2>
            <p>
                Four levels, so today's story always meets you where you are.
                Move up whenever it starts to feel easy.
            </p>
        </div>
        <div class="level-grid">
            <% orderedLevels.forEach((level, idx) => {
                   const info = levelInfo[level] || { name: '', desc: '' }; %>
                <div class="level-card">
                    <div class="level-bars" aria-hidden="true">
                        <% ['30%', '55%', '80%', '100%'].forEach((h, bi) => { %>
                            <span style="height: <%= h %>;<%= bi <= idx ? ' background: var(--accent);' : '' %>"></span>
                        <% }) %>
                    </div>
                    <div class="level-card-head">
                        <span class="level-card-name"><%= info.name %></span>
                        <span class="level-card-cefr"><%= level %></span>
                    </div>
                    <p><%= info.desc %></p>
                </div>
            <% }) %>
        </div>
    </section>

    <!-- ============ CLOSING ============ -->
    <section class="closing">
        <div class="closing-inner">
            <p class="eyebrow">Today's story is waiting</p>
            <h2>Five minutes a day is how a language sticks.</h2>
            <a href="#top" class="btn-cta">Pick a language →</a>
            <div class="closing-note">Free · No sign-up · A fresh story every morning</div>
        </div>
    </section>

    <%- include('partials/footer') %>

    <script>
        (function () {
            // ---- Hero picker: navigate to the chosen story ------------------
            const form = document.getElementById('storyForm');
            const languageSelect = document.getElementById('language');
            const levelSelect = document.getElementById('level');
            const startBtn = form.querySelector('.btn-start');
            const pickerError = document.getElementById('pickerError');

            function refreshStart() {
                const ready = Boolean(languageSelect.value && levelSelect.value);
                startBtn.setAttribute('aria-disabled', String(!ready));
                if (ready) pickerError.hidden = true;
            }

            languageSelect.addEventListener('change', refreshStart);
            levelSelect.addEventListener('change', refreshStart);
            refreshStart();

            form.addEventListener('submit', function (e) {
                e.preventDefault();
                const language = languageSelect.value;
                const level = levelSelect.value;
                if (!language || !level) {
                    pickerError.hidden = false;
                    (!language ? languageSelect : levelSelect).focus();
                    return;
                }
                window.location.href = '/' + language + '/' + level;
            });

            // ---- Story showcase: interactive sample stories -----------------
            const STORIES = [
                {
                    title: 'En la cafetería', lang: 'Spanish', native: 'Español', cefr: 'A1', levelName: 'Beginner',
                    gloss: 'Ordering and paying at a café counter.',
                    lines: [
                        { who: 'Camarero', text: '¡Hola! ¿Qué desea tomar?',      trans: 'Hi! What would you like to drink?' },
                        { who: 'Cliente',  text: 'Un café con leche, por favor.',  trans: 'A coffee with milk, please.' },
                        { who: 'Camarero', text: '¿Grande o pequeño?',             trans: 'Large or small?' },
                        { who: 'Cliente',  text: 'Pequeño. ¿Cuánto es?',           trans: 'Small. How much is it?' },
                        { who: 'Camarero', text: 'Son dos euros, por favor.',      trans: "That's two euros, please." }
                    ],
                    q: 'What does the customer order?',
                    options: ['A small tea', 'A coffee with milk', 'A glass of water', 'Nothing at all'],
                    answer: 1
                },
                {
                    title: 'Le week-end', lang: 'French', native: 'Français', cefr: 'A2', levelName: 'Conversational',
                    gloss: 'Two friends make weekend plans around the weather.',
                    lines: [
                        { who: 'Clara', text: 'Tu fais quoi ce week-end ?',             trans: 'What are you doing this weekend?' },
                        { who: 'Hugo',  text: 'Je ne sais pas encore. Peut-être du vélo.', trans: "I don't know yet. Maybe cycling." },
                        { who: 'Clara', text: 'Il va pleuvoir samedi.',                 trans: "It's going to rain on Saturday." },
                        { who: 'Hugo',  text: "Alors dimanche, s'il fait beau.",        trans: "Then Sunday, if the weather's nice." },
                        { who: 'Clara', text: 'Bonne idée ! On y va ensemble ?',        trans: 'Good idea! Shall we go together?' }
                    ],
                    q: 'When might Hugo go cycling?',
                    options: ['Saturday morning', 'Sunday, if the weather is nice', 'Not this weekend', 'Right now'],
                    answer: 1
                },
                {
                    title: 'Al mercato', lang: 'Italian', native: 'Italiano', cefr: 'A1', levelName: 'Beginner',
                    gloss: 'Buying fruit from a stall at the market.',
                    lines: [
                        { who: 'Venditore', text: 'Buongiorno! Cosa desidera?',        trans: 'Good morning! What would you like?' },
                        { who: 'Cliente',   text: 'Vorrei un chilo di mele.',          trans: "I'd like a kilo of apples." },
                        { who: 'Venditore', text: 'Rosse o verdi?',                    trans: 'Red or green?' },
                        { who: 'Cliente',   text: 'Rosse, per favore. Quanto costa?',  trans: 'Red, please. How much is it?' },
                        { who: 'Venditore', text: 'Due euro e cinquanta.',            trans: 'Two euros fifty.' }
                    ],
                    q: 'What does the customer buy?',
                    options: ['A bottle of wine', 'A kilo of red apples', 'Some fresh bread', 'A few tomatoes'],
                    answer: 1
                }
            ];

            const tabsEl = document.getElementById('storyTabs');
            const cardEl = document.getElementById('storyCard');
            const state = { active: 0, picked: null, showEn: false };

            function esc(s) {
                return String(s).replace(/[&<>"']/g, function (c) {
                    return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
                });
            }

            function renderTabs() {
                tabsEl.innerHTML = STORIES.map(function (st, i) {
                    return '<button class="story-tab' + (i === state.active ? ' is-active' : '') +
                        '" data-tab="' + i + '" role="tab" aria-selected="' + (i === state.active) + '">' +
                        esc(st.lang + ' · ' + st.levelName) + '</button>';
                }).join('');
            }

            function renderCard() {
                const s = STORIES[state.active];
                const first = s.lines[0].who;
                const answered = state.picked !== null;

                const lines = s.lines.map(function (l) {
                    const side = l.who === first ? 'left' : 'right';
                    const trans = state.showEn
                        ? '<div class="msg-trans">' + esc(l.trans) + '</div>' : '';
                    return '<div class="msg ' + side + '"><div class="msg-inner">' +
                        '<div class="msg-who">' + esc(l.who) + '</div>' +
                        '<div class="bubble">' + esc(l.text) + '</div>' + trans +
                        '</div></div>';
                }).join('');

                const options = s.options.map(function (opt, i) {
                    let cls = 'opt', mark = '';
                    if (answered) {
                        if (i === s.answer) { cls += ' correct'; mark = '✓'; }
                        else if (i === state.picked) { cls += ' wrong'; mark = '✗'; }
                        else { cls += ' dim'; }
                    }
                    return '<button class="' + cls + '" data-opt="' + i + '"' +
                        (answered ? ' disabled' : '') + '>' +
                        '<span class="opt-letter">' + 'ABCD'[i] + '</span>' +
                        '<span class="opt-text">' + esc(opt) + '</span>' +
                        '<span class="opt-mark">' + mark + '</span></button>';
                }).join('');

                let feedback = '';
                if (answered) {
                    const correct = state.picked === s.answer;
                    const text = correct
                        ? 'Exactly right. ' + s.gloss
                        : 'Not quite — the answer is ' + 'ABCD'[s.answer] + '. ' + s.gloss;
                    feedback = '<div class="quiz-feedback ' + (correct ? 'is-correct' : 'is-wrong') + '">' +
                        '<span class="quiz-feedback-text">' + esc(text) + '</span>' +
                        '<button class="btn-next" data-next>Read another →</button></div>';
                }

                cardEl.innerHTML =
                    '<div class="story-card-head"><div>' +
                        '<div class="story-card-title">' + esc(s.title) + '</div>' +
                        '<div class="story-card-gloss">' + esc(s.gloss) + '</div>' +
                    '</div><span class="story-card-tag">' + esc(s.native + ' · ' + s.cefr) + '</span></div>' +
                    '<div class="story-lines">' + lines +
                        '<div class="toggle-en-wrap"><button class="toggle-en" data-toggle-en>' +
                        (state.showEn ? 'Hide English' : 'Show English') + '</button></div>' +
                    '</div>' +
                    '<div class="quiz' + (answered ? ' answered' : '') + '">' +
                        '<div class="quiz-q"><span class="quiz-q-dot">?</span>' +
                        '<span class="quiz-q-text">' + esc(s.q) + '</span></div>' +
                        '<div class="quiz-options">' + options + '</div>' +
                        feedback +
                    '</div>';
            }

            function goto(i) {
                state.active = ((i % STORIES.length) + STORIES.length) % STORIES.length;
                state.picked = null;
                state.showEn = false;
                renderTabs();
                renderCard();
            }

            tabsEl.addEventListener('click', function (e) {
                const btn = e.target.closest('[data-tab]');
                if (btn) goto(parseInt(btn.getAttribute('data-tab'), 10));
            });

            cardEl.addEventListener('click', function (e) {
                const opt = e.target.closest('[data-opt]');
                if (opt && state.picked === null) {
                    state.picked = parseInt(opt.getAttribute('data-opt'), 10);
                    renderCard();
                    return;
                }
                if (e.target.closest('[data-toggle-en]')) {
                    state.showEn = !state.showEn;
                    renderCard();
                    return;
                }
                if (e.target.closest('[data-next]')) {
                    goto(state.active + 1);
                }
            });

            renderTabs();
            renderCard();
        })();
    </script>
</body>
</html>
