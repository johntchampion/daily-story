<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" type="image/png" href="/images/favicon.png" />
    <link rel="apple-touch-icon" href="/images/icon.png" />
    <title>Get started · Daily Story</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="/css/index.css">
    <link rel="stylesheet" href="/css/onboarding.css">

</head>
<body>
    <%
        // Presentation copy for the onboarding cards and the story preview,
        // keyed by the language names in SUPPORTED_LANGUAGES. Any supported
        // language without an entry here is simply skipped, and any entry for
        // an unsupported language never renders — the injected `languages`
        // array is the single source of truth.
        const langMeta = {
            English:    { code: 'EN', native: 'English',    greeting: 'Hello!',     story: { title: 'Breakfast',         a: 'Do you want a croissant?',  b: 'Yes, please!' } },
            Spanish:    { code: 'ES', native: 'Español',    greeting: '¡Hola!',     story: { title: 'El desayuno',       a: '¿Quieres un cafecito?',     b: '¡Sí, claro que sí!' } },
            French:     { code: 'FR', native: 'Français',   greeting: 'Bonjour !',  story: { title: 'Le petit déjeuner', a: 'Tu veux un croissant ?',    b: 'Oui, avec plaisir !' } },
            German:     { code: 'DE', native: 'Deutsch',    greeting: 'Hallo!',     story: { title: 'Das Frühstück',     a: 'Möchtest du ein Brötchen?', b: 'Ja, sehr gerne!' } },
            Italian:    { code: 'IT', native: 'Italiano',   greeting: 'Ciao!',      story: { title: 'La colazione',      a: 'Vuoi un cornetto?',         b: 'Sì, volentieri!' } },
            Portuguese: { code: 'PT', native: 'Português',  greeting: 'Olá!',       story: { title: 'O pequeno-almoço',  a: 'Queres um pastel?',         b: 'Sim, claro!' } },
            Chinese:    { code: 'ZH', native: '中文',        greeting: '你好！',      story: { title: '早餐',              a: '你想要包子吗？',             b: '好的，谢谢！' } },
            Japanese:   { code: 'JA', native: '日本語',      greeting: 'こんにちは!',  story: { title: '朝ごはん',          a: 'パンはいかがですか。',       b: 'はい、お願いします！' } }
        };

        const obLanguages = languages.filter(lang => langMeta[lang]);

        // The skill self-assessment (step 2) and reasons (step 3) questions
        // are injected from the server (src/questions/) so the same option
        // list backs both what's rendered here and what's recorded as a
        // user_response on submit. Assessment options are filtered to levels
        // the app actually supports, matching the `languages`/`obLanguages`
        // pattern above.
        const obAssessments = skillAssessmentQuestion.options.filter(opt => levels.includes(opt.value));
        const obReasons = reasonsQuestion.options;
    %>

    <div class="grain" aria-hidden="true"></div>

    <div class="ob-page">
        <!-- ============ HEADER ============ -->
        <header class="site-header">
            <a class="brand" href="/">
                <span class="brand-dot"></span>
                <span class="brand-name">Daily Story</span>
            </a>
            <a class="ob-skip" href="/">Skip for now →</a>
        </header>

        <!-- ============ PROGRESS ============ -->
        <div class="ob-progress">
            <div class="ob-progress-meta">
                <span class="ob-kicker" id="obKicker"></span>
                <span class="ob-count" id="obCount"></span>
            </div>
            <div class="ob-track">
                <div class="ob-bar" id="obBar"></div>
            </div>
        </div>

        <!-- ============ STEPS ============ -->
        <main class="ob-main" id="obMain">

            <!-- Step 1: Language -->
            <div class="ob-step" id="obStep1">
                <h1 class="ob-title">Which language are we reading in?</h1>
                <p class="ob-sub">You can always add another later — stories come in all of these.</p>
                <div class="ob-lang-grid">
                    <% obLanguages.forEach(lang => { const meta = langMeta[lang]; %>
                        <button class="ob-choice ob-lang" data-lang="<%= meta.code %>">
                            <span class="ob-lang-chip"><%= meta.code %></span>
                            <span class="ob-lang-text">
                                <span class="ob-lang-native"><%= meta.native %></span>
                                <span class="ob-lang-english"><%= lang %></span>
                            </span>
                        </button>
                    <% }) %>
                </div>
                <div class="ob-actions ob-actions-end">
                    <button class="ob-finish" id="obNext1" data-next disabled>Next →</button>
                </div>
            </div>

            <!-- Step 2: Level -->
            <div class="ob-step" id="obStep2">
                <div class="ob-greeting" id="obGreeting2"></div>
                <h1 class="ob-title">How does your <span id="obLangName2">it</span> feel right now?</h1>
                <p class="ob-sub">Be honest — there are no wrong answers, only the right first story.</p>
                <div class="ob-level-list">
                    <% obAssessments.forEach(opt => { %>
                        <button class="ob-choice ob-level" data-level="<%= opt.value %>" data-assessment="<%= opt.id %>">
                            <span class="ob-level-label"><%= opt.label %></span>
                            <span class="ob-level-cefr"><%= opt.value %></span>
                        </button>
                    <% }) %>
                </div>
                <div class="ob-actions">
                    <button class="ob-back" data-back>← Back</button>
                    <button class="ob-finish" id="obNext2" data-next disabled>Next →</button>
                </div>
            </div>

            <!-- Step 3: Reasons -->
            <div class="ob-step" id="obStep3">
                <h1 class="ob-title">What's pulling you toward <span id="obLangName3">it</span>?</h1>
                <p class="ob-sub">Pick as many as you like — we'll lean your stories that way.</p>
                <div class="ob-reason-grid">
                    <% obReasons.forEach(reason => { %>
                        <button class="ob-choice ob-reason" data-reason="<%= reason.id %>">
                            <span class="ob-reason-dot"></span>
                            <span class="ob-reason-text">
                                <span class="ob-reason-title"><%= reason.label %></span>
                                <span class="ob-reason-sub"><%= reason.description %></span>
                            </span>
                        </button>
                    <% }) %>
                </div>
                <div class="ob-actions">
                    <button class="ob-back" data-back>← Back</button>
                    <button class="ob-finish" id="obFinish" data-finish>Skip this one →</button>
                </div>
            </div>

            <!-- Step 4: Done -->
            <div class="ob-step ob-step-done" id="obStep4">
                <div class="ob-greeting" id="obGreeting4"></div>
                <h1 class="ob-title ob-title-done">Your first story is ready.</h1>
                <p class="ob-sub ob-sub-done" id="obSummary"></p>
                <div class="ob-preview">
                    <div class="ob-preview-head">
                        <span class="ob-preview-title" id="obStoryTitle"></span>
                        <span class="ob-preview-tag" id="obStoryTag"></span>
                    </div>
                    <div class="ob-preview-msg">
                        <div class="ob-bubble ob-bubble-a" id="obStoryA"></div>
                    </div>
                    <div class="ob-preview-msg right">
                        <div class="ob-bubble ob-bubble-b" id="obStoryB"></div>
                    </div>
                </div>
                <form class="ob-done-form" method="post" action="/profile/onboarding">
                    <input type="hidden" name="language" id="obInputLang" value="">
                    <input type="hidden" name="level" id="obInputLevel" value="">
                    <input type="hidden" name="skillAssessment" id="obInputAssessment" value="">
                    <div id="obReasonInputs"></div>
                    <button type="submit" class="btn-cta ob-done-cta">Read my first story →</button>
                </form>
                <div class="ob-change"><button class="ob-back" data-back>← Change my answers</button></div>
            </div>

        </main>
    </div>

    <script>
        (function () {
            // Built server-side from the same data that renders the language
            // cards, keyed by the code stored in each card's data-lang.
            var LANGS = <%- JSON.stringify(Object.fromEntries(obLanguages.map(function (lang) {
                var meta = langMeta[lang];
                return [meta.code, { native: meta.native, english: lang, greeting: meta.greeting }];
            }))) %>;

            var STORIES = <%- JSON.stringify(Object.fromEntries(obLanguages.map(function (lang) {
                return [langMeta[lang].code, langMeta[lang].story];
            }))) %>;

            var REASON_LABELS = <%- JSON.stringify(Object.fromEntries(obReasons.map(function (reason) {
                return [reason.id, reason.label.toLowerCase()];
            }))) %>;

            var KICKERS = { 1: 'Let\'s set up your story', 2: 'Finding your level', 3: 'Making it yours', 4: 'All set' };
            var PROGRESS = { 1: 8, 2: 38, 3: 70, 4: 100 };

            var selectedLang = null;
            var selectedLevel = null;
            var selectedAssessment = null;
            var selectedReasons = [];
            var currentStep = 1;

            var barEl = document.getElementById('obBar');
            var kickerEl = document.getElementById('obKicker');
            var countEl = document.getElementById('obCount');

            function showStep(n) {
                currentStep = n;
                document.querySelectorAll('.ob-step').forEach(function (el) {
                    el.classList.remove('ob-step--active');
                });
                document.getElementById('obStep' + n).classList.add('ob-step--active');
                barEl.style.width = PROGRESS[n] + '%';
                kickerEl.textContent = KICKERS[n];
                countEl.textContent = n < 4 ? 'Step ' + n + ' of 3' : 'Done';
            }

            function populateStep4() {
                var lang = LANGS[selectedLang];
                var story = (selectedLang && STORIES[selectedLang]) || STORIES[Object.keys(STORIES)[0]];
                var picked = selectedReasons.map(function (id) { return REASON_LABELS[id] || id; });
                var flavor = '';
                if (picked.length === 1) {
                    flavor = ' Expect a lean toward ' + picked[0] + '.';
                } else if (picked.length > 1) {
                    flavor = ' Expect a lean toward ' + picked.slice(0, -1).join(', ') + ' and ' + picked[picked.length - 1] + '.';
                }
                document.getElementById('obGreeting4').textContent = lang ? lang.greeting : '';
                document.getElementById('obSummary').textContent =
                    'Every morning: a short ' + (lang ? lang.english : '') +
                    ' conversation at ' + (selectedLevel || 'your') +
                    ' level, with three quick questions after.' + flavor;
                document.getElementById('obStoryTitle').textContent = story.title;
                document.getElementById('obStoryA').textContent = story.a;
                document.getElementById('obStoryB').textContent = story.b;
                document.getElementById('obStoryTag').textContent =
                    (lang ? lang.native : '') + ' · ' + (selectedLevel || '');

                // Feed the chosen language (canonical English name), level,
                // self-assessment, and reasons into the form that saves
                // preferences, records the richer answers, and opens the story.
                document.getElementById('obInputLang').value = lang ? lang.english : '';
                document.getElementById('obInputLevel').value = selectedLevel || '';
                document.getElementById('obInputAssessment').value = selectedAssessment || '';

                var reasonInputs = document.getElementById('obReasonInputs');
                reasonInputs.innerHTML = '';
                selectedReasons.forEach(function (id) {
                    var input = document.createElement('input');
                    input.type = 'hidden';
                    input.name = 'reasons';
                    input.value = id;
                    reasonInputs.appendChild(input);
                });
            }

            document.getElementById('obMain').addEventListener('click', function (e) {
                var langBtn = e.target.closest('[data-lang]');
                if (langBtn) {
                    document.querySelectorAll('[data-lang]').forEach(function (b) { b.classList.remove('is-selected'); });
                    langBtn.classList.add('is-selected');
                    selectedLang = langBtn.dataset.lang;
                    var lang = LANGS[selectedLang];
                    document.getElementById('obGreeting2').textContent = lang ? lang.greeting : '';
                    document.getElementById('obLangName2').textContent = lang ? lang.english : 'it';
                    document.getElementById('obLangName3').textContent = lang ? lang.english : 'it';
                    document.getElementById('obNext1').disabled = false;
                    return;
                }

                var levelBtn = e.target.closest('[data-level]');
                if (levelBtn) {
                    document.querySelectorAll('[data-level]').forEach(function (b) { b.classList.remove('is-selected'); });
                    levelBtn.classList.add('is-selected');
                    selectedLevel = levelBtn.dataset.level;
                    selectedAssessment = levelBtn.dataset.assessment;
                    document.getElementById('obNext2').disabled = false;
                    return;
                }

                if (e.target.closest('[data-next]')) {
                    showStep(currentStep + 1);
                    return;
                }

                var reasonBtn = e.target.closest('[data-reason]');
                if (reasonBtn) {
                    var id = reasonBtn.dataset.reason;
                    var idx = selectedReasons.indexOf(id);
                    if (idx === -1) {
                        selectedReasons.push(id);
                        reasonBtn.classList.add('is-selected');
                    } else {
                        selectedReasons.splice(idx, 1);
                        reasonBtn.classList.remove('is-selected');
                    }
                    document.getElementById('obFinish').textContent =
                        selectedReasons.length > 0 ? 'Continue →' : 'Skip this one →';
                    return;
                }

                if (e.target.closest('[data-finish]')) {
                    populateStep4();
                    showStep(4);
                    return;
                }

                if (e.target.closest('[data-back]')) {
                    showStep(Math.max(1, currentStep - 1));
                }
            });

            showStep(1);
        })();
    </script>
</body>
</html>
